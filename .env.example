# Pick ONE imagery source in accident_svi.py (see the import + fetch call near
# the top of main()) and set its key/token below. The other can stay blank.

# Google Street View Static API key — used by adb_pipeline/stage2_gsv.py
GSV_API_KEY=your_key_here

# Mapillary Images API access token — used by adb_pipeline/stage2_mapillary.py
# Get one at https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=your_client_token_here

# ViDA Demonstrator PHPSESSID cookie — used by SRS_pipeline/extract_irap_srs.py
# DevTools > Application > Cookies > demonstrator.vida.irap.org. Expires; refresh after re-login.
VIDA_PHPSESSID=your_phpsessid_here
